{
  "expo": {
    "name": "Lockwords",
    "slug": "lockwords",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockwords",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.comebackhamid.lockwords",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.comebackhamid.lockwords"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f8fa",
          "image": "./assets/images/splash.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Lockwords uses the microphone when you tap the mic to speak your message. It turns your voice into text.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "Lockwords",
              "displayName": "Lockwords",
              "description": "Your hard words, one at a time.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/lockwords-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
