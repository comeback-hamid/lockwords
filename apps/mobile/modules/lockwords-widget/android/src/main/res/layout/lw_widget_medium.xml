<?xml version="1.0" encoding="utf-8"?>
<!-- Medium (4 cells wide): the text on the left with the example sentence, a bigger Kai on the right.
     Figma: Widgets, Home Screen, medium. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/lw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/lw_card"
  android:clipToOutline="true"
  android:gravity="bottom"
  android:orientation="horizontal"
  android:padding="14dp">
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/lw_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="monospace"
      android:letterSpacing="0.05"
      android:maxLines="1"
      android:text="@string/lw_label_brand"
      android:textColor="@color/lw_brand"
      android:textSize="11sp"
      android:textStyle="bold" />
    <!-- textAlignment viewStart + textDirection firstStrong: Persian, Arabic and Hebrew start at the right. -->
    <TextView
      android:id="@+id/lw_word"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Lockwords"
      android:textAlignment="viewStart"
      android:textColor="@color/lw_text"
      android:textDirection="firstStrong"
      android:textSize="26sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/lw_meaning"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/lw_widget_description"
      android:textAlignment="viewStart"
      android:textColor="@color/lw_muted"
      android:textDirection="firstStrong"
      android:textSize="15sp" />
    <TextView
      android:id="@+id/lw_example"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:textAlignment="viewStart"
      android:textColor="@color/lw_muted"
      android:textDirection="firstStrong"
      android:textSize="13sp" />
    <!-- Pushes the squares to the bottom. (A widget may not use the Space view.) -->
    <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout
      android:id="@+id/lw_squares"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <ImageView android:id="@+id/lw_sq1" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/lw_square_empty" />
      <ImageView android:id="@+id/lw_sq2" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/lw_square_empty" />
      <ImageView android:id="@+id/lw_sq3" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/lw_square_empty" />
      <ImageView android:id="@+id/lw_sq4" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/lw_square_empty" />
      <ImageView android:id="@+id/lw_sq5" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:src="@drawable/lw_square_empty" />
    </LinearLayout>
  </LinearLayout>
  <ImageView
    android:id="@+id/lw_kai"
    android:layout_width="124dp"
    android:layout_height="88dp"
    android:layout_marginStart="10dp"
    android:contentDescription="@string/lw_kai"
    android:scaleType="fitCenter"
    android:src="@drawable/lw_kai_idle" />
</LinearLayout>
