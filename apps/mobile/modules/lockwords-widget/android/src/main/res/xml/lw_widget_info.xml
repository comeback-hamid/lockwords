<?xml version="1.0" encoding="utf-8"?>
<!-- 2 by 2 cells when it is added (the small look); made 4 cells wide it shows the medium look.
     updatePeriodMillis: Android's shortest is 30 minutes, the length of one word slot. The widget also wakes itself
     at the start of each slot (HardWordsWidget). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:minResizeWidth="110dp"
  android:minResizeHeight="110dp"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:resizeMode="horizontal|vertical"
  android:updatePeriodMillis="1800000"
  android:initialLayout="@layout/lw_widget_small"
  android:previewLayout="@layout/lw_widget_small"
  android:description="@string/lw_widget_description"
  android:widgetCategory="home_screen" />
