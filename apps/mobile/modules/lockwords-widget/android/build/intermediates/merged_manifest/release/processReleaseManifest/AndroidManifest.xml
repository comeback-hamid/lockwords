<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.comebackhamid.lockwords.widget" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!-- The home screen widget. Android merges this into the app's manifest. -->
        <receiver
            android:name="com.comebackhamid.lockwords.widget.HardWordsWidget"
            android:exported="true"
            android:label="@string/lw_widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lw_widget_info" />
        </receiver>
    </application>

</manifest>