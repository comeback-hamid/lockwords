# The app talks to the CLOUD when these three are not set (see src/config/backend.ts).
# For the local stack, copy this file to .env.local (never commit it). `npm run dev:up` from the repo root writes it for you.
# Set all three or none.
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
# The anon key is public (it ships inside the app). Local value: `supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
