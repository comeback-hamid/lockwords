{
  "openapi": "3.1.0",
  "info": {
    "title": "Lockwords API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isGuest": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "isGuest",
          "createdAt"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "WordTest": {
        "type": "object",
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "bands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "basic",
                    "intermediate",
                    "advanced"
                  ]
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "level",
                "words"
              ]
            }
          }
        },
        "required": [
          "supported",
          "bands"
        ]
      },
      "BadRequest": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "bad_request"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Estimate": {
        "type": "object",
        "properties": {
          "knownWords": {
            "type": "integer"
          },
          "outOf": {
            "type": "integer"
          },
          "cefr": {
            "type": "string"
          }
        },
        "required": [
          "knownWords",
          "outOf",
          "cefr"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "learningLanguage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "nativeLanguage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "level": {
            "type": "string",
            "enum": [
              "brand_new",
              "beginner",
              "some_basics",
              "intermediate",
              "advanced"
            ]
          },
          "knownWords": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5000
          },
          "cefr": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4
          },
          "goal": {
            "type": "string",
            "enum": [
              "travel",
              "work",
              "move_abroad",
              "family_friends",
              "brain",
              "school",
              "other"
            ]
          },
          "goalOther": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "food",
                "travel",
                "work",
                "business",
                "tech",
                "science",
                "music",
                "movies",
                "books",
                "sports",
                "fitness",
                "health",
                "nature",
                "animals",
                "art",
                "fashion",
                "gaming",
                "news",
                "family",
                "friends_dating",
                "shopping",
                "cooking",
                "money",
                "culture"
              ]
            },
            "minItems": 1,
            "maxItems": 24
          }
        },
        "required": [
          "learningLanguage",
          "nativeLanguage",
          "level",
          "knownWords",
          "cefr",
          "goal",
          "goalOther",
          "interests"
        ]
      },
      "DeckIdeas": {
        "type": "object",
        "properties": {
          "ideas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ideas"
        ]
      },
      "ProfileChat": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "chatLanguage": {
            "type": "string",
            "enum": [
              "native",
              "target"
            ]
          }
        },
        "required": [
          "name",
          "chatLanguage"
        ]
      },
      "NoProfile": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "no_profile"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Deck": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "cefr": {
            "type": "string"
          },
          "wordCount": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "generating",
              "ready"
            ]
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          }
        },
        "required": [
          "id",
          "topic",
          "title",
          "reason",
          "cefr",
          "wordCount",
          "status",
          "cards"
        ]
      },
      "Card": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "translation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "exampleTranslation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "id": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "stage": {
            "type": "integer"
          }
        },
        "required": [
          "word",
          "translation",
          "example",
          "exampleTranslation",
          "id",
          "position",
          "stage"
        ]
      },
      "NotFound": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "not_found"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "GenerationFailed": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "generation_failed"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Round": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewCard"
            }
          }
        },
        "required": [
          "cards"
        ]
      },
      "ReviewCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "deckId": {
            "type": "string"
          },
          "deckTopic": {
            "type": "string"
          },
          "word": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "exampleTranslation": {
            "type": "string"
          },
          "stage": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "deckId",
          "deckTopic",
          "word",
          "translation",
          "example",
          "exampleTranslation",
          "stage"
        ]
      },
      "HardWords": {
        "type": "object",
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string"
                },
                "translation": {
                  "type": "string"
                }
              },
              "required": [
                "word",
                "translation"
              ]
            }
          }
        },
        "required": [
          "words"
        ]
      },
      "SwipeResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "type": "integer"
          },
          "known": {
            "type": "boolean"
          },
          "hard": {
            "type": "boolean"
          },
          "backInDays": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "stage",
          "known",
          "hard",
          "backInDays"
        ]
      },
      "UseItResult": {
        "type": "object",
        "properties": {
          "good": {
            "type": "boolean"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "maxItems": 4
          },
          "movedUp": {
            "type": "boolean"
          },
          "stage": {
            "type": "integer"
          }
        },
        "required": [
          "good",
          "lines",
          "movedUp",
          "stage"
        ]
      },
      "CheckFailed": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "check_failed"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "KaiReply": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "onScript": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "onScript",
              "answer"
            ]
          },
          {
            "type": "object",
            "properties": {
              "onScript": {
                "type": "boolean",
                "enum": [
                  false
                ]
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "minItems": 1,
                "maxItems": 2
              }
            },
            "required": [
              "onScript",
              "lines"
            ]
          }
        ]
      },
      "KaiUnavailable": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "kai_unavailable"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "KaiReplyRequest": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "name",
              "language",
              "topic",
              "proposed",
              "generating",
              "ready"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 6
          }
        },
        "required": [
          "step",
          "text"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/me": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Who the caller is",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/word-test": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "required": true,
            "name": "language",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Three word lists, or supported: false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordTest"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/word-test/estimate": {
      "post": {
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "known": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 200
                  }
                },
                "required": [
                  "language",
                  "known"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "About how many common words the user knows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Estimate"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile": {
      "put": {
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deck-ideas": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Four first-deck topics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckIdeas"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile/chat": {
      "put": {
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileChat"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileChat"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "409": {
            "description": "Save the profile first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoProfile"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decks": {
      "post": {
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "topic"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A proposed deck with no cards yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deck"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "409": {
            "description": "Save the profile first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoProfile"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decks/{id}/generate": {
      "post": {
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The ready deck with its cards; or still generating (read the deck again in a moment)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deck"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "No such deck",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "502": {
            "description": "The AI call failed; nothing was saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationFailed"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decks/{id}": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The deck with its cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deck"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "No such deck",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/v1/review": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Today's cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Round"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hard-words": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Words that go to the lock screen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HardWords"
                }
              }
            }
          },
          "401": {
            "description": "No valid login token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cards/{id}/swipe": {
      "post": {
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "direction": {
