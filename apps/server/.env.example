# Copy to .env (never commit .env). Local databases: lockwords_dev (app) and lockwords_test (tests).
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://localhost:5432/lockwords_dev
# Supabase (login only). Local values from `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Optional. Empty = every deck is the fixture deck (src/llm/fixture.ts).
ANTHROPIC_API_KEY=
# Cloud: these come from .do/app.yaml and GitHub Actions secrets, not from a .env file (see "Deploy" in docs/architecture.md).
# The web app addresses that may call the API from a browser, comma separated. Empty = only localhost.
WEB_ORIGINS=
