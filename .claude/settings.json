{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "git", "url": "https://github.com/DietrichGebert/ponytail.git" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "openspec list 2>/dev/null || true" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edits.sh" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-checks.sh", "timeout": 600 }] }
    ]
  }
}
