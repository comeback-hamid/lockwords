{
  "name": "lockwords",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w @lockwords/server",
    "e2e": "bash scripts/e2e.sh",
    "db:setup": "bash scripts/db-setup.sh",
    "spec:validate": "openspec validate --all --strict",
    "docs:html": "node scripts/docs-html.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:up": "bash scripts/dev-up.sh"
  },
  "engines": {
    "node": ">=22"
  }
}
